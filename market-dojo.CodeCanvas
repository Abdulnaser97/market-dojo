			"endLine": 10,
			"parentCellId": "ad27b752-5cd0-4a9f-b920-6f55460f6731",
			"parentPath": "src/routes/profile.tsx",
			"simSteps": [
				{
					"simulationKey": "User Authentication and Account Management",
					"simStepId": "84e06024-ecf7-4178-a2de-4f933048da6a"
				}
			]
		},
		"46a8ddf0-9f7b-4d4f-8118-38025f4b8cef": {
			"path": "46a8ddf0-9f7b-4d4f-8118-38025f4b8cef",
			"cellName": "Database: Validate Session - auth.ts:L46-54",
			"cellId": "46a8ddf0-9f7b-4d4f-8118-38025f4b8cef",
			"visible": true,
			"parentCellId": "dc313b0b-4957-40bb-a764-2fc3479978ca"
		},
		"src/lib/auth.ts-simstep-c543c455-1420-48c4-8f93-ed539d811e1b": {
			"path": "src/lib/auth.ts-simstep-c543c455-1420-48c4-8f93-ed539d811e1b",
			"fileName": "auth.ts",
			"wiki": "The server uses the session token to query the `sessions` table in the database. It finds the matching session, joins it with the `users` table to get user details, and verifies that the session has not expired.",
			"cellName": "Database: Validate Session - auth.ts:L46-54",
			"cellId": "46a8ddf0-9f7b-4d4f-8118-38025f4b8cef",
			"visible": true,
			"startLine": 46,
			"endLine": 54,
			"parentCellId": "dc313b0b-4957-40bb-a764-2fc3479978ca",
			"parentPath": "src/lib/auth.ts",
			"simSteps": [
				{
					"simulationKey": "User Authentication and Account Management",
					"simStepId": "c543c455-1420-48c4-8f93-ed539d811e1b"
				}
			]
		},
		"189f5d8d-8e73-48a3-9e5b-232a8819d342": {
			"path": "189f5d8d-8e73-48a3-9e5b-232a8819d342",
			"cellName": "Profile Page: Render User Data - profile.tsx:L122-248",
			"cellId": "189f5d8d-8e73-48a3-9e5b-232a8819d342",
			"visible": true,
			"parentCellId": "ad27b752-5cd0-4a9f-b920-6f55460f6731"
		},
		"src/routes/profile.tsx-simstep-f7a456de-8dd5-442f-a7a3-23bbfda98934": {
			"path": "src/routes/profile.tsx-simstep-f7a456de-8dd5-442f-a7a3-23bbfda98934",
			"fileName": "profile.tsx",
			"wiki": "The `profile.tsx` component receives the session data. It uses this data to render the user's information, such as their email and ID. It also triggers another server call, `getUserStats`, to fetch and display learning statistics.",
