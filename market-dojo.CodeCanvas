					"simulationKey": "Gamified Pattern Recognition Training in a Real-Time Market Simulator",
					"simStepId": "46b49b0b-4461-419c-bde5-14b4723ce7a6"
				}
			]
		},
		"d992fe4e-cb2f-4dc3-b4c2-c6291785b63a": {
			"path": "d992fe4e-cb2f-4dc3-b4c2-c6291785b63a",
			"cellName": "Backend Updates Session & Pattern Mastery - submit.ts:L74-161",
			"cellId": "d992fe4e-cb2f-4dc3-b4c2-c6291785b63a",
