		"28059e3b-2e10-4c62-ab27-bfa86041d0c9": {
			"path": "28059e3b-2e10-4c62-ab27-bfa86041d0c9",
			"cellName": "Calculate Adaptive Weight - submit.ts:L115-123",
			"cellId": "28059e3b-2e10-4c62-ab27-bfa86041d0c9",
