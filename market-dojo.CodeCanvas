			"path": "src/routes/api/auth/signout.ts-simstep-b7736c4e-fecc-4f64-a9c0-d0dd6ced932b",
			"fileName": "signout.ts",
			"wiki": "The `/api/auth/signout.ts` endpoint receives the request. It finds the session token in the cookies and sends a command to the database to delete the corresponding record from the `sessions` table, effectively invalidating the session.",
			"cellName": "Backend: Invalidate Session - signout.ts:L24-28",
			"cellId": "a322774c-dc0e-487a-9cc8-c7e6985be9d9",
			"visible": true,
			"startLine": 24,
