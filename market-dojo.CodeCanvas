					},
					"inputDataExample": "{\"type\": \"QUIZ_EVENT\", \"payload\": {\"question\": \"What pattern is forming here?\", \"options\": [...], \"correctAnswer\": \"Bullish Engulfing\", \"pattern\": {\"name\": \"Bullish Engulfing\", \"candleIndices\": [120, 121]}}}",
					"outputDataExample": "{\"type\": \"QUIZ_EVENT\", \"payload\": {\"question\": \"What pattern is forming here?\", \"options\": [...], \"correctAnswer\": \"Bullish Engulfing\", \"pattern\": {\"name\": \"Bullish Engulfing\", \"candleIndices\": [120, 121]}}}"
				},
				{
					"simStepId": "ec3a196f-fbcf-4ac7-bd18-18b57e7b2176",
