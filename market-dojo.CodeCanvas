		"c758fad8-20ef-4857-8595-a9232436fc4e": {
			"path": "c758fad8-20ef-4857-8595-a9232436fc4e",
			"cellName": "User Starts Simulation - play.tsx:L6-188",
			"cellId": "c758fad8-20ef-4857-8595-a9232436fc4e",
			"visible": true,
			"parentCellId": "06c3e0b0-c42c-497e-ba13-f1ef363d6c64"
		},
		"src/routes/play.tsx-simstep-1043bd03-09b0-4b3e-b851-466370158c71": {
			"path": "src/routes/play.tsx-simstep-1043bd03-09b0-4b3e-b851-466370158c71",
			"fileName": "play.tsx",
			"wiki": "The user navigates to the `/play` page and clicks the 'Start Simulation' button. This action initiates an asynchronous function `startSimulation` which first calls the backend to create a new session record.",
			"cellName": "User Starts Simulation - play.tsx:L6-188",
			"cellId": "c758fad8-20ef-4857-8595-a9232436fc4e",
			"visible": true,
			"startLine": 6,
			"endLine": 188,
