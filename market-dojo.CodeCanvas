		"src/routes/profile.tsx-simstep-84e06024-ecf7-4178-a2de-4f933048da6a": {
			"path": "src/routes/profile.tsx-simstep-84e06024-ecf7-4178-a2de-4f933048da6a",
			"fileName": "profile.tsx",
			"wiki": "The `profile.tsx` component begins rendering. It calls the `getUserSession` server function, which internally uses `getSession` from `src/lib/auth.ts` to verify the user's authentication state on the server.",
			"cellName": "Profile Page: Fetch Session - profile.tsx:L7-10",
			"cellId": "19092755-9ee7-4b41-b18d-13fc37be72ed",
			"visible": true,
