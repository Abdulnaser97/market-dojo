					"simStepLabel": "Data Persistence: Schema to SQL Migration",
					"simStepDescription": "The Drizzle ORM schema definitions for `portfolios` and `orders` are translated into a raw SQL migration script. This script contains the `CREATE TABLE` statements that will be executed against the database to create the actual tables.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "migrations/0000_lively_black_bird.sql",
						"startLine": "53",
						"endLine": "96",
						"relevantVariables": [
							"CREATE TABLE `orders`",
							"CREATE TABLE `portfolios`"
						]
					},
					"inputDataExample": "CREATE TABLE `portfolios` (\n\t`id` text PRIMARY KEY NOT NULL,\n\t`user_id` text NOT NULL,\n\t`starting_balance` real DEFAULT 10000 NOT NULL,\n\t`leverage` real DEFAULT 1 NOT NULL,\n\tFOREIGN KEY (`user_id`) REFERENCES `users`(`id`) ON UPDATE no action ON DELETE cascade\n);\n\nCREATE TABLE `orders` (\n\t`id` text PRIMARY KEY NOT NULL,\n\t`portfolio_id` text NOT NULL,\n\t`symbol` text NOT NULL,\n\t`type` text NOT NULL,\n\t`status` text NOT NULL,\n\tFOREIGN KEY (`portfolio_id`) REFERENCES `portfolios`(`id`) ON UPDATE no action ON DELETE cascade\n);",
					"outputDataExample": "CREATE TABLE `portfolios` (\n\t`id` text PRIMARY KEY NOT NULL,\n\t`user_id` text NOT NULL,\n\t`starting_balance` real DEFAULT 10000 NOT NULL,\n\t`leverage` real DEFAULT 1 NOT NULL,\n\tFOREIGN KEY (`user_id`) REFERENCES `users`(`id`) ON UPDATE no action ON DELETE cascade\n);\n\nCREATE TABLE `orders` (\n\t`id` text PRIMARY KEY NOT NULL,\n\t`portfolio_id` text NOT NULL,\n\t`symbol` text NOT NULL,\n\t`type` text NOT NULL,\n\t`status` text NOT NULL,\n\tFOREIGN KEY (`portfolio_id`) REFERENCES `portfolios`(`id`) ON UPDATE no action ON DELETE cascade\n);"
				},
				{
					"simStepId": "81ad6c4d-b6d4-4ac1-87e9-35560d6df5a0",
					"diagramNodeId": "dfec027d-152a-4e89-b300-ff06fe1d695b",
					"simStepLabel": "Database Migration: Apply Schema",
					"simStepDescription": "The generated SQL migration script is executed against the Cloudflare D1 database (or a local equivalent during development). This command creates the `portfolios` and `orders` tables, making the paper trading data structure persistent and ready for the application to use once the trading logic is implemented.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "migrations/0000_lively_black_bird.sql",
						"startLine": "84",
						"endLine": "96",
						"relevantVariables": [
							"CREATE TABLE `portfolios`"
						]
					},
					"inputDataExample": "{\n  \"command\": \"wrangler d1 migrations apply marketdojo_db --local\"\n}",
					"outputDataExample": "{\n  \"status\": \"success\",\n  \"tables_created\": [\n    \"portfolios\",\n    \"orders\"\n  ]\n}"
				}
			],
			"description": "<ul><li>This feature, outlined in the README and supported by the database schema, provides a safe environment for users to apply their knowledge</li><li>While the backend schema is in place, the frontend implementation appears to be a future development</li><li>- Users can have simulated brokerage accounts (portfolios) with a configurable starting balance</li><li>- The schema supports placing different types of orders (market, limit, stop) for long or short positions</li><li>- The system is designed to track portfolio metrics like current balance, equity, and realized profit/loss from closed trades</li><li>- This feature allows users to practice risk management, order execution, and emotional discipline without risking real money</li></ul>",
