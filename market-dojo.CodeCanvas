				}
			]
		},
		"5b528c7b-3b14-43fb-940a-210415dca3a8": {
			"path": "5b528c7b-3b14-43fb-940a-210415dca3a8",
			"cellName": "Simulation Ends & Final Results Compiled - simulator.worker.ts:L569-588",
			"cellId": "5b528c7b-3b14-43fb-940a-210415dca3a8",
