					"simStepLabel": "Message: Send `QUIZ_EVENT` to Main Thread",
					"simStepDescription": "As the simulation progresses, the worker's scheduler decides to trigger a quiz. It identifies a pattern in the recent data and posts a 'QUIZ_EVENT' message to the main thread, containing the pattern details, a question, and answer options.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/game/simulator.worker.ts",
