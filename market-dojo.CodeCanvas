		"src/game/simulator.worker.ts-simstep-28b9602f-fb1e-4df5-a0be-7104d858b562": {
			"path": "src/game/simulator.worker.ts-simstep-28b9602f-fb1e-4df5-a0be-7104d858b562",
			"fileName": "simulator.worker.ts",
			"wiki": "The `SimulatorWorker`'s `handleAnswerSubmission` function is triggered. It calculates the time taken, checks if the answer is correct, and passes this information to the `ScoringEngine`.",
