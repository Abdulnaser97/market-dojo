	"simulations": {
		"Gamified Pattern Recognition Training in a Real-Time Market Simulator": {
			"name": "Gamified Pattern Recognition Training in a Real-Time Market Simulator",
			"simSteps": [
				{
					"simStepId": "1043bd03-09b0-4b3e-b851-466370158c71",
					"diagramNodeId": "c758fad8-20ef-4857-8595-a9232436fc4e",
					"simStepLabel": "User Starts Simulation",
					"simStepDescription": "The user navigates to the `/play` page and clicks the 'Start Simulation' button. This action initiates an asynchronous function `startSimulation` which first calls the backend to create a new session record.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/routes/play.tsx",
						"startLine": "6",
						"endLine": "188",
						"relevantVariables": [
							"startSimulation",
							"fetch(\"/api/session/start\")"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"sessionId\": \"d8f8a7c7-5b6a-4b7c-8b0a-9c7d8e9f0a1b\", \"createdAt\": \"2023-10-27T10:00:00.000Z\"}"
				},
				{
					"simStepId": "b852cfa1-2033-4fe0-b0bf-dbdf4bf016b6",
					"diagramNodeId": "7b7c3879-0cfb-4264-bd83-3fb525f4d6d3",
					"simStepLabel": "API Call: Start Session",
					"simStepDescription": "The frontend sends a POST request to the `/api/session/start` endpoint to initialize a new quiz session in the database before the simulation begins.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/routes/play.tsx",
						"startLine": "6",
						"endLine": "188",
						"relevantVariables": [
							"fetch"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "bfe6205d-1a9c-4654-a941-edf999c3883c",
					"diagramNodeId": "6280130a-fa34-469d-b705-a8ecd6116551",
					"simStepLabel": "Backend Creates Session Record",
					"simStepDescription": "The backend API route `/api/session/start` receives the request. It verifies the user's session, generates a unique session ID, and inserts a new record into the `sessionResults` table with initial values (score 0, accuracy 0, etc.).",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/routes/api/session/start.ts",
						"startLine": "13",
						"endLine": "42",
						"relevantVariables": [
							"POST",
							"getSession",
							"db.insert(sessionResults)"
						]
					},
					"inputDataExample": "{\"user\": {\"id\": \"user_123\", \"email\": \"player@example.com\"}}",
					"outputDataExample": "{\"success\": true, \"sessionId\": \"d8f8a7c7-5b6a-4b7c-8b0a-9c7d8e9f0a1b\", \"createdAt\": \"2023-10-27T10:00:00.000Z\"}"
				},
				{
					"simStepId": "f50a8804-89ad-48e2-8056-c7889e09aa78",
					"diagramNodeId": "59fb3935-3799-44db-a0f3-8a5969e98622",
					"simStepLabel": "Return Session ID",
					"simStepDescription": "The backend responds with a JSON object containing the newly created `sessionId` and a timestamp, confirming that the session has been initialized.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/routes/api/session/start.ts",
						"startLine": "1",
						"endLine": "42",
						"relevantVariables": [
							"json(response)"
						]
					},
					"inputDataExample": "{\"success\": true, \"sessionId\": \"d8f8a7c7-5b6a-4b7c-8b0a-9c7d8e9f0a1b\", \"createdAt\": \"2023-10-27T10:00:00.000Z\"}",
					"outputDataExample": "{\"success\": true, \"sessionId\": \"d8f8a7c7-5b6a-4b7c-8b0a-9c7d8e9f0a1b\", \"createdAt\": \"2023-10-27T10:00:00.000Z\"}"
				},
				{
					"simStepId": "55d946ed-ed4a-4d99-85cd-9cf71c729264",
					"diagramNodeId": "1852eaa1-696b-456d-a93e-c44b5a88b7b9",
					"simStepLabel": "Initialize & Start Web Worker",
					"simStepDescription": "Back on the frontend, `play.tsx` receives the new session ID. It then posts a `START` message to the `SimulatorWorker`, which has already been initialized with historical candlestick data. This begins the simulation loop.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/routes/play.tsx",
						"startLine": "6",
						"endLine": "188",
						"relevantVariables": [
							"worker.postMessage"
						]
					},
					"inputDataExample": "{\"type\": \"START\"}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "0e9fb311-2775-4bf0-9a2b-378db4646156",
					"diagramNodeId": "7804343d-3b74-44ac-80c9-fda4bf54d693",
					"simStepLabel": "Data Flow: Tick Event",
					"simStepDescription": "The `SimulatorWorker` runs its `tick` loop, processing one candlestick at a time. On each tick, it sends a `TICK` message containing the current candle data and progress percentage back to the main UI thread.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/game/simulator.worker.ts",
						"startLine": "4",
						"endLine": "607",
						"relevantVariables": [
							"sendMessage"
						]
					},
					"inputDataExample": "{\"type\": \"TICK\", \"payload\": {\"candle\": {\"time\": 1672689600, \"open\": 16545, \"high\": 16560, \"low\": 16520, \"close\": 16535}, \"index\": 51, \"progress\": 5.1}}",
					"outputDataExample": "{\"type\": \"TICK\", \"payload\": {\"candle\": {\"time\": 1672689600, \"open\": 16545, \"high\": 16560, \"low\": 16520, \"close\": 16535}, \"index\": 51, \"progress\": 5.1}}"
				},
				{
					"simStepId": "69590880-7f76-4cf5-af93-6ea6e2b8ef22",
					"diagramNodeId": "ca8700cb-fe2c-4d82-b03b-c4c091197bb0",
					"simStepLabel": "Worker Detects Candlestick Pattern",
					"simStepDescription": "The `SimulatorWorker`'s `tick` function determines it is time to generate a quiz. It calls `generateQuiz`, which gathers the recent candlestick data and passes it to `PatternService.detectPatterns` to find a recognizable pattern.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/game/simulator.worker.ts",
						"startLine": "398",
						"endLine": "408",
						"relevantVariables": [
							"generateQuiz",
							"PatternService.detectPatterns",
							"visibleData"
						]
					},
					"inputDataExample": "{\"visibleData\": [{\"time\": 1672689600, \"open\": 16545, \"high\": 16560, \"low\": 16520, \"close\": 16535}, ...], \"currentIndex\": 75}",
					"outputDataExample": "{\"name\": \"Bullish Engulfing\", \"type\": \"reversal\", \"confidence\": 85, \"sentiment\": \"bullish\", \"candleIndices\": [74, 75]}"
				},
				{
					"simStepId": "c8159c70-1fa0-48e8-9bed-31c47f33d5fa",
					"diagramNodeId": "01b478c7-c451-4677-9c57-f64ca95bcc42",
					"simStepLabel": "Data Flow: Quiz Event",
					"simStepDescription": "After a pattern is successfully identified, the worker constructs a quiz object, including the correct answer and three distractors. It then sends a `QUIZ_EVENT` message to the main UI thread.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/game/simulator.worker.ts",
						"startLine": "603",
						"endLine": "603",
						"relevantVariables": [
							"sendMessage(\"QUIZ_EVENT\", quiz)"
						]
					},
					"inputDataExample": "{\"type\": \"QUIZ_EVENT\", \"payload\": {\"question\": \"What candlestick pattern is forming here?\", \"options\": [{\"label\": \"A\", \"value\": \"Bearish Harami\"}, {\"label\": \"B\", \"value\": \"Bullish Engulfing\"}, {\"label\": \"C\", \"value\": \"Doji\"}, {\"label\": \"D\", \"value\": \"Hammer\"}], \"correctAnswer\": \"Bullish Engulfing\", \"pattern\": {\"name\": \"Bullish Engulfing\"}, \"timeLimit\": 15}}",
					"outputDataExample": "{\"type\": \"QUIZ_EVENT\", \"payload\": {\"question\": \"What candlestick pattern is forming here?\", \"options\": [{\"label\": \"A\", \"value\": \"Bearish Harami\"}, {\"label\": \"B\", \"value\": \"Bullish Engulfing\"}, {\"label\": \"C\", \"value\": \"Doji\"}, {\"label\": \"D\", \"value\": \"Hammer\"}], \"correctAnswer\": \"Bullish Engulfing\", \"pattern\": {\"name\": \"Bullish Engulfing\"}, \"timeLimit\": 15}}"
				},
				{
					"simStepId": "d75b7b17-d79e-4ee8-b2cc-962f6700b757",
					"diagramNodeId": "1a3c0143-bc25-44ca-a1ac-dffca1ef8e49",
					"simStepLabel": "Display Quiz Dialog",
					"simStepDescription": "The `play.tsx` component receives the `QUIZ_EVENT` message. It pauses the simulation, updates its state with the quiz data, and renders the `QuizDialog` component, which displays the question and multiple-choice answers to the user.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/routes/play.tsx",
						"startLine": "184",
						"endLine": "191",
						"relevantVariables": [
							"worker.onmessage",
							"setCurrentQuiz"
						]
					},
					"inputDataExample": "{\"type\": \"QUIZ_EVENT\", \"payload\": {\"question\": \"What candlestick pattern is forming here?\", \"options\": [...], \"correctAnswer\": \"Bullish Engulfing\", ...}}",
					"outputDataExample": "{\"selectedAnswer\": \"Bullish Engulfing\"}"
				},
				{
					"simStepId": "6aaad655-3009-4504-96b6-e124eb60a10f",
					"diagramNodeId": "85acfc33-d64a-42c6-9ce0-c3e9013ef109",
					"simStepLabel": "Data Flow: Submit Answer",
					"simStepDescription": "The user selects an answer in the `QuizDialog`. This triggers a function in `play.tsx` to send a `SUBMIT_ANSWER` message, containing the chosen answer, back to the `SimulatorWorker` for scoring.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/components/game/QuizDialog.tsx",
						"startLine": "111",
						"endLine": "111",
						"relevantVariables": [
							"props.onAnswer"
						]
					},
					"inputDataExample": "{\"type\": \"SUBMIT_ANSWER\", \"payload\": {\"answer\": \"Bullish Engulfing\"}}",
					"outputDataExample": "{\"type\": \"SUBMIT_ANSWER\", \"payload\": {\"answer\": \"Bullish Engulfing\"}}"
				},
				{
					"simStepId": "28b9602f-fb1e-4df5-a0be-7104d858b562",
					"diagramNodeId": "ad996492-5345-455b-ba02-53dec59a5ae1",
					"simStepLabel": "Worker Scores Answer",
					"simStepDescription": "The `SimulatorWorker`'s `handleAnswerSubmission` function is triggered. It calculates the time taken, checks if the answer is correct, and passes this information to the `ScoringEngine`.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/game/simulator.worker.ts",
						"startLine": "486",
						"endLine": "528",
						"relevantVariables": [
							"handleAnswerSubmission",
							"scoringEngine.submitAnswer",
							"isCorrect",
							"timeTaken"
						]
					},
					"inputDataExample": "{\"payload\": {\"answer\": \"Bullish Engulfing\"}}",
					"outputDataExample": "{\"scoreUpdate\": {\"score\": 150, \"streak\": 1, \"correctCount\": 1, \"incorrectCount\": 0, \"pointsEarned\": 150}}"
				},
				{
					"simStepId": "330250cc-b091-406c-bf43-6f9108156ae1",
					"diagramNodeId": "b828fe0a-b10b-4f30-9b63-81fa2699f651",
					"simStepLabel": "Data Flow: Score Update",
					"simStepDescription": "The `ScoringEngine` calculates the points earned (including time and streak bonuses) and returns a `ScoreUpdate` object. The worker then sends this object in a `SCORE_UPDATE` message to the main thread to update the HUD.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/game/simulator.worker.ts",
						"startLine": "522",
						"endLine": "522",
						"relevantVariables": [
							"sendMessage(\"SCORE_UPDATE\", scoreUpdate)"
						]
					},
					"inputDataExample": "{\"type\": \"SCORE_UPDATE\", \"payload\": {\"score\": 150, \"streak\": 1, \"pointsEarned\": 150, \"correctCount\": 1, \"totalQuestions\": 1}}",
					"outputDataExample": "{\"type\": \"SCORE_UPDATE\", \"payload\": {\"score\": 150, \"streak\": 1, \"pointsEarned\": 150, \"correctCount\": 1, \"totalQuestions\": 1}}"
				},
				{
					"simStepId": "46b49b0b-4461-419c-bde5-14b4723ce7a6",
					"diagramNodeId": "5b528c7b-3b14-43fb-940a-210415dca3a8",
					"simStepLabel": "Simulation Ends & Final Results Compiled",
					"simStepDescription": "The `SimulatorWorker` reaches the end of the market data. It pauses the simulation and compiles a final summary object, including the final score, accuracy, max streak, and a detailed list of every pattern quiz attempt.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/game/simulator.worker.ts",
						"startLine": "569",
						"endLine": "588",
						"relevantVariables": [
							"tick",
							"scoringEngine.getScoreUpdate",
							"scoringEngine.getPatternAttempts",
							"sendMessage(\"COMPLETE\", ...)"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"totalCandles\": 1000, \"score\": 1250, \"correctCount\": 8, \"incorrectCount\": 2, \"accuracy\": 0.8, \"maxStreak\": 5, \"patternAttempts\": [{\"patternName\": \"Bullish Engulfing\", \"correct\": true, \"timeTaken\": 4.5}, ...]}"
				},
				{
					"simStepId": "f46c0a83-2884-492f-871b-09c7e95a388e",
					"diagramNodeId": "433d2f6c-b194-4e00-bdda-22cbb7d9c67f",
					"simStepLabel": "API Call: Submit Session Results",
					"simStepDescription": "The main thread receives the 'COMPLETE' message and triggers `handleSessionComplete`. This function sends a POST request to `/api/session/submit` with the complete session summary to be persisted.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/routes/play.tsx",
						"startLine": "6",
						"endLine": "188",
						"relevantVariables": [
							"handleSessionComplete",
							"fetch(\"/api/session/submit\", ...)"
						]
					},
					"inputDataExample": "{\"sessionId\": \"d8f8a7c7-5b6a-4b7c-8b0a-9c7d8e9f0a1b\", \"score\": 1250, \"accuracy\": 0.8, \"duration\": 300, \"maxStreak\": 5, \"patternResults\": [{\"patternName\": \"Bullish Engulfing\", \"correct\": true, \"timeTaken\": 4.5}, ...]}",
					"outputDataExample": "{\"sessionId\": \"d8f8a7c7-5b6a-4b7c-8b0a-9c7d8e9f0a1b\", \"score\": 1250, \"accuracy\": 0.8, \"duration\": 300, \"maxStreak\": 5, \"patternResults\": [{\"patternName\": \"Bullish Engulfing\", \"correct\": true, \"timeTaken\": 4.5}, ...]}"
				},
				{
					"simStepId": "daedc991-ab3a-4cc8-bc43-e94ced68d539",
					"diagramNodeId": "d992fe4e-cb2f-4dc3-b4c2-c6291785b63a",
					"simStepLabel": "Backend Updates Session & Pattern Mastery",
					"simStepDescription": "The `/api/session/submit` endpoint receives the final results. It first updates the `sessionResults` record with the final score and stats. Then, it iterates through each pattern attempt and updates the corresponding user record in the `patternMastery` table, adjusting counts, accuracy, and the adaptive weight for future quizzes.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/routes/api/session/submit.ts",
						"startLine": "74",
						"endLine": "161",
						"relevantVariables": [
							"db.update(sessionResults)",
							"db.update(patternMastery)",
							"db.insert(patternMastery)",
							"patternResults"
						]
					},
					"inputDataExample": "{\"sessionId\": \"d8f8a7c7-5b6a-4b7c-8b0a-9c7d8e9f0a1b\", \"score\": 1250, \"accuracy\": 0.8, ...}",
					"outputDataExample": "{\"success\": true, \"sessionId\": \"d8f8a7c7-5b6a-4b7c-8b0a-9c7d8e9f0a1b\", \"mastery\": [{\"userId\": \"user_123\", \"patternName\": \"Bullish Engulfing\", \"accuracy\": 0.85, \"weight\": 0.9}, ...]}"
				},
				{
					"simStepId": "ea00a4ad-e8a9-4b58-90ac-681125894e61",
					"diagramNodeId": "1220f28a-b706-43f5-b7b4-5297f6db3465",
					"simStepLabel": "Return Success & Updated Mastery",
					"simStepDescription": "After successfully updating all database records, the backend sends a success response to the client, including the user's newly updated pattern mastery profile.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/routes/api/session/submit.ts",
						"startLine": "1",
						"endLine": "169",
						"relevantVariables": [
							"json(response)"
						]
