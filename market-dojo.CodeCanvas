			"fileName": "simulator.worker.ts",
			"wiki": "The `SimulatorWorker` reaches the end of the market data. It pauses the simulation and compiles a final summary object, including the final score, accuracy, max streak, and a detailed list of every pattern quiz attempt.",
			"cellName": "Simulation Ends & Final Results Compiled - simulator.worker.ts:L569-588",
			"cellId": "5b528c7b-3b14-43fb-940a-210415dca3a8",
