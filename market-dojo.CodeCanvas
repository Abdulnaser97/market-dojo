			"fileName": "SessionSummary.tsx",
			"wiki": "After all patterns are processed, the API returns a success response. The frontend uses this data to render the `SessionSummary` component, which shows the user their final score, accuracy, and how their mastery levels for each pattern have changed.",
			"cellName": "Display Session Summary - SessionSummary.tsx:L1",
			"cellId": "e9176cc0-145b-436c-afa1-1f3fa930224d",
			"visible": true,
