		"src/db/schema.ts-simstep-f87913ca-8a06-4f04-aa97-9ae6f7e21faa": {
			"path": "src/db/schema.ts-simstep-f87913ca-8a06-4f04-aa97-9ae6f7e21faa",
			"fileName": "schema.ts",
			"wiki": "The system defines the structure for the `orders` table. This table is designed to store details for each simulated trade, such as the associated portfolio, the symbol being traded (e.g., BTC/USD), order type (market, limit), side (long/short), quantity, prices, status, and the final realized profit or loss (PnL).",
			"cellName": "Database Schema: Define Trade Orders - schema.ts:L164-184",
			"cellId": "68ab3f97-3cb0-4d85-b5e1-9153a61c005a",
			"visible": true,
