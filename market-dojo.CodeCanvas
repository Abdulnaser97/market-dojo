		"src/routes/api/session/submit.ts-simstep-daedc991-ab3a-4cc8-bc43-e94ced68d539": {
			"path": "src/routes/api/session/submit.ts-simstep-daedc991-ab3a-4cc8-bc43-e94ced68d539",
			"fileName": "submit.ts",
			"wiki": "The `/api/session/submit` endpoint receives the final results. It first updates the `sessionResults` record with the final score and stats. Then, it iterates through each pattern attempt and updates the corresponding user record in the `patternMastery` table, adjusting counts, accuracy, and the adaptive weight for future quizzes.",
			"cellName": "Backend Updates Session & Pattern Mastery - submit.ts:L74-161",
			"cellId": "d992fe4e-cb2f-4dc3-b4c2-c6291785b63a",
			"visible": true,
			"startLine": 74,
			"endLine": 161,
			"parentCellId": "64fe2534-b415-4d6d-a528-4c8f856c5e15",
			"parentPath": "src/routes/api/session/submit.ts",
			"simSteps": [
