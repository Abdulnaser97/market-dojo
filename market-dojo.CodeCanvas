			"parentCellId": "64fe2534-b415-4d6d-a528-4c8f856c5e15"
		},
		"src/routes/api/session/submit.ts-simstep-587177e4-b5fd-4ad4-b42d-7863e982d9ae": {
			"path": "src/routes/api/session/submit.ts-simstep-587177e4-b5fd-4ad4-b42d-7863e982d9ae",
			"fileName": "submit.ts",
			"wiki": "Based on whether the user's answer was correct or incorrect, the system calculates a new accuracy score and adjusts the pattern's `weight`. A correct answer decreases the weight (making the pattern appear less often), while an incorrect answer increases it (making it appear more often in future sessions).",
			"cellName": "Calculate Adaptive Weight - submit.ts:L115-123",
			"cellId": "28059e3b-2e10-4c62-ab27-bfa86041d0c9",
			"visible": true,
