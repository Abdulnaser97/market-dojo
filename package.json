{
  "name": "marketdojo",
  "version": "0.1.0",
  "description": "Trading education platform with interactive lessons and paper trading",
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply marketdojo_db --local",
    "db:migrate:prod": "wrangler d1 migrations apply marketdojo_db --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-lessons-sql.ts && wrangler d1 execute marketdojo_db --local --file=migrations/seed-lessons.sql",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\""
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@auth/drizzle-adapter": "^1.11.1",
    "@auth/solid-start": "^0.19.1",
    "@libsql/client": "^0.15.15",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.3",
    "@solidjs/start": "^1.2.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.7",
    "solid-js": "^1.9.3",
    "vinxi": "^0.5.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^3.95.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.7.0+sha512.dc09430156b427f5ecfc79888899e1c39d2d690f004be70e05230b72cb173d96839587545d09429b55ac3c429c801b4dc3c0e002f653830a420fa2dd4e3cf9cf"
}
